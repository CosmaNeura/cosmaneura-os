# Copy into the deployment secret/configuration system; empty required values fail startup.
COSMAS_ENV=early_adopter_beta
DATA_MODE=synthetic
AUTH_MODE=clerk_jwt
SYNTH_SEED=false
SYNC_WORKER=false
BLOB_BACKEND=azure
WORKSPACE_ENABLED=true
WORKSPACE_AUTHENTICATED_ENABLED=true
WORKSPACE_HOSTED_ENABLED=true
WORKSPACE_DRAFT_RECOVERY_REQUIRED=true
WORKSPACE_TEAM_SETUP_ENABLED=true
WORKSPACE_AI_ACTIVITY_ENABLED=true
WORKSPACE_ROUTINES_ENABLED=true
WORKSPACE_APPLE_HOSTED_TRANSPORT_ENABLED=true
WORKSPACE_DESKTOP_HOSTED_TRANSPORT_ENABLED=true
CORS_ALLOWED_ORIGINS=https://workspace.example.invalid,capacitor://localhost,app://cosmas
CLERK_AUTHORIZED_PARTIES=https://workspace.example.invalid,capacitor://localhost,app://cosmas
BETA_BOX_ID=
CLERK_ISSUER=
CLERK_JWKS_URL=
CLERK_AUDIENCE=
CLERK_ORGANIZATION_ID=
AZURE_STORAGE_ACCOUNT_URL=
AZURE_BLOB_CONTAINER=
HUMAN_DEPLOY_EVIDENCE_REF=
DATABASE_URL=
REDIS_URL=
# Capture/model/vendor activation is configured and accepted separately.
# Optional immutable mounted account catalog plus exact SHA256. See docs/managed-services.md.
MANAGED_SERVICES_CONFIG_PATH=
# Alternative: a Key Vault-backed environment secret; never supply both forms.
MANAGED_SERVICES_CONFIG_JSON=
MANAGED_SERVICES_CONFIG_SHA256=
# COSMAS_MANAGED_SECRET_<NAME> values come from deployment secret references, never this file.
VENDOR_SETUP_ENABLED=false
VENDOR_WORK_ENABLED=false
VENDOR_IO_ENABLED=false
VENDOR_EVENTS_ENABLED=false
FINANCE_SETUP_ENABLED=false
FINANCE_WORK_ENABLED=false
FINANCE_IO_ENABLED=false
FINANCE_EVENTS_ENABLED=false
WORKSPACE_CORE_CONNECTION_ENABLED=false
WORKSPACE_CORE_APPOINTMENT_SETUP_ENABLED=false
# Athena reads use the connected Core account and its separately reviewed practice profile.
WORKSPACE_ATHENA_CONNECTION_ENABLED=false
# Reviewed local reference links; requires read-only Athena and Core connection.
WORKSPACE_ATHENA_VISIT_LINK_ENABLED=false
# Populate the reviewed Core origin and tenant for this Box before enabling.
CORE_CAPTURE_ORIGIN=
CORE_CONNECTION_TENANT_REF=

# Enable only with an existing reviewed SchedulingAccount and accepted Google audience.
WORKSPACE_SCHEDULING_ENABLED=false
WORKSPACE_SCHEDULING_LOGIN_ENABLED=false
SCHEDULING_ORIGIN=
SCHEDULING_GOOGLE_CLIENT_ID=
SCHEDULING_GOOGLE_CLIENT_SECRET=
SCHEDULING_GOOGLE_CALLBACK_URI=
SCHEDULING_LOGIN_RETURN_ORIGIN=
# Base64url encoded 32-byte key, stored in the deployment secret manager.
SCHEDULING_LOGIN_ENCRYPTION_KEY=

# Personal Microsoft email/calendar (read-only delegated access; default off).
WORKSPACE_MICROSOFT_CONNECTION_ENABLED=false
MICROSOFT_CONNECTION_TENANT_ID=
MICROSOFT_CONNECTION_CLIENT_ID=
MICROSOFT_CONNECTION_CLIENT_SECRET=
MICROSOFT_CONNECTION_CALLBACK_URI=
MICROSOFT_CONNECTION_RETURN_ORIGIN=
MICROSOFT_CONNECTION_ENCRYPTION_KEY=

# Optional first connection for members of one owner-reviewed Scheduling practice.
WORKSPACE_SCHEDULING_ENROLLMENT_ENABLED=false
SCHEDULING_ENROLLMENT_PRACTICE_ID=

# Personal Google/Gmail metadata connection; separate from Scheduling/Calendar.
WORKSPACE_GOOGLE_CONNECTION_ENABLED=false
GOOGLE_CONNECTION_CLIENT_ID=
GOOGLE_CONNECTION_CLIENT_SECRET=
GOOGLE_CONNECTION_CALLBACK_URI=
GOOGLE_CONNECTION_RETURN_ORIGIN=
GOOGLE_CONNECTION_ENCRYPTION_KEY=
