    "SecureQueuePlugin",
    "CosmasWorkspaceAuthPlugin",
    "CosmasPrivateSpeechPlugin"
  ],
  "server": {
    "hostname": "localhost",
    "iosScheme": "capacitor"
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": false
    }
  }
}
