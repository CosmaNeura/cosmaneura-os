.env
.env.*
!.env.example
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyright/
.coverage
htmlcov/
node_modules/
dist/
build/
tmp/
*.log
*.sqlite3
secrets/
credentials/
