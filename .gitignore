.cursor/

# Terraform (D2 local state — never commit secrets/state)
infra/.terraform/
infra/.terraform.tfstate.lock.info
infra/*.tfstate
infra/*.tfstate.*
infra/tfplan*
infra/*.tfplan
infra/crash*.log
infra/override.tf
infra/override.tf.json
infra/*_override.tf
infra/*_override.tf.json
infra/terraform.tfvars
infra/*.tfvars.json
infra/*.auto.tfvars
infra/*.auto.tfvars.json
infra/.apply-env
!infra/terraform.tfvars.example
.terraformrc
terraform.rc

# Terraform (all nested environment roots, including D3 beta)
**/.terraform/
**/.terraform.tfstate.lock.info
**/*.tfstate
**/*.tfstate.*
**/tfplan*
**/*.tfplan
**/crash*.log
**/backend.hcl
**/override.tf
**/override.tf.json
**/*_override.tf
**/*_override.tf.json
**/terraform.tfvars
**/*.tfvars.json
**/*.auto.tfvars
**/*.auto.tfvars.json
**/.apply-env
!**/terraform.tfvars.example

# Generated local release metadata can embed host-specific image IDs.
artifacts/releases/manifest-*.json

# TypeScript incremental build metadata is generated by local and container builds.
web/tsconfig.tsbuildinfo
