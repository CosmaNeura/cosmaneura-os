{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["vitest/globals"],
    "paths": {
      "@cosmaneura-scribe/capture-protocol": ["../clients/capture/protocol/generated.ts"],
      "@cosmaneura-scribe/capacitor-ios-pcm": ["../clients/capture/plugins/ios-pcm/index.ts"],
      "@cosmaneura-scribe/capacitor-secure-queue": ["../clients/capture/plugins/secure-queue/index.ts"]
    }
  },
  "include": ["src"]
}
