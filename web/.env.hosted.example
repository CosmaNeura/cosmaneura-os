# Public build configuration only. Never place server credentials here.
# This profile includes every implemented beta workflow; do not set individual gates.
VITE_WORKSPACE_FEATURE_PROFILE=operational-beta-v1
VITE_WORKSPACE_HOSTED_CLIENT=web
VITE_WORKSPACE_DATA_MODE=synthetic
VITE_WORKSPACE_HOSTED_API_ORIGIN=https://api.example.invalid
VITE_API_BASE=https://api.example.invalid
VITE_WORKSPACE_WEB_ORIGIN=https://workspace.example.invalid
VITE_COSMANEURA_WEB_ORIGIN=https://core.example.invalid
VITE_CAPTURE_UPLOAD_ORIGINS=https://uploads.example.invalid
VITE_WORKSPACE_CAPTURE_MODE=browser_microphone
VITE_CLERK_PUBLISHABLE_KEY=
# Build: pnpm run build:beta. These invented origins do not activate services.
# Capture modes: synthetic (synthetic data only), browser_microphone (web/desktop),
# ios_native (Apple; native custody/recovery required). No mode starts recording.
# Desktop: CLIENT=desktop, WEB_ORIGIN empty, API_BASE=app://cosmas/api.
# Apple: CLIENT=apple, WEB_ORIGIN empty, CAPTURE_MODE=ios_native.
# Native composers must use these same Core/upload/API origins and capture mode.
# Native auth activation, real service grants and device/release acceptance remain separate.
