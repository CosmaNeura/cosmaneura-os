+private final class SourceTestClock: PCMSourceClock, @unchecked Sendable {
+  private let lock = NSLock()
+  let timer = ManualClock()
+  private var wall: Int64 = 1_000_000
+  private var monotonic: UInt64 = 0
+  func now() -> PCMSourceTime {
+    lock.withLock { PCMSourceTime(epochMilliseconds: wall, monotonicNanoseconds: monotonic) }
+  }
+  func advance(wall: Int64, milliseconds: UInt64) {
+    lock.withLock { self.wall += wall; monotonic += milliseconds * 1_000_000 }
+  }
+  func sleep(nanoseconds: UInt64) async throws { try await timer.sleep(nanoseconds: nanoseconds) }
+}
