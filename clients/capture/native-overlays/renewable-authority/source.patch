+private struct RenewableHarness {
+  let audio: FakeAudioDriver
+  let sink = FakeSink()
+  let clock = SourceTestClock()
+  let core: IOSPCMCore
+  let configuration: PCMConfiguration
+  let runID = "2e4968c5-856f-4b4a-a2a3-82fb25f441a8"
+
+  init(target: Int = 4, initial: Int = 2, hard: Int = 8,
+    permission: any MicrophonePermissionAuthorizing = GrantedPermission(),
+    audio: FakeAudioDriver = FakeAudioDriver()) throws
+  {
+    self.audio = audio
+    core = IOSPCMCore(permission: permission, audio: audio, sink: sink,
+      clock: ManualClock(), sourceClock: clock)
+    configuration = try PCMConfiguration(targetFramesPerChunk: target, maximumChunks: initial,
+      maximumInputFramesPerBuffer: target,
+      authority: PCMSourceAuthority(runID: runID, generation: 1,
+        expiresAtMilliseconds: 1_001_000, hardMaximumChunks: hard))
+  }
+
+  func renewal(_ generation: Int, chunks: Int) -> PCMSourceExtension {
+    PCMSourceExtension(runID: runID, generation: generation,
+      expiresAtMilliseconds: 1_000_000 + Int64(generation) * 1_000, maximumChunks: chunks)
+  }
+  func ready() async throws -> IOSPCMSessionHandle {
+    let session = try core.start(configuration: configuration)
+    try await session.ready()
+    return session
+  }
+}
