+  func testRenewalPreserves44100HzPhasePCMAndSequenceAcrossThreeExtensions() async throws {
+    let h = try RenewableHarness(target: 16)
+    let session = try await h.ready()
+    let input = (0..<300).map { Float(sin(Double($0) * 0.1)) }
+    for offset in stride(from: 0, to: 300, by: 10) {
+      if offset == 30 { try await session.extend(h.renewal(2, chunks: 4)) }
+      if offset == 100 { try await session.extend(h.renewal(3, chunks: 6)) }
+      if offset == 180 {
+        try await session.extend(h.renewal(4, chunks: 8))
+        try await session.extend(h.renewal(4, chunks: 8))
+      }
+      let frames = OwnedAudioFrames(sampleRateHz: 44_100,
+        channels: [Array(input[offset..<(offset + 10)])])
+      await h.audio.emitLatest(frames)
+      XCTAssertTrue(frames.isZeroed)
+      for ack in h.sink.acknowledgements { ack.complete(.accepted) }
+    }
+    let result = try await session.stop(.drain)
+    var golden = try AreaWeightedPCM16Resampler(sourceRate: 44_100, targetRate: 16_000,
+      maximumOutputFrames: 128)
+    let expected = try golden.push(input) + golden.finish()
+    let actual = h.sink.snapshots.flatMap { $0 } + (result.finalPacket?.bytes.testingCopy() ?? [])
+    XCTAssertEqual(actual, encodePCM16LE(expected))
+    XCTAssertEqual(h.sink.sequences, [0, 1, 2, 3, 4, 5])
+    XCTAssertEqual(result.finalPacket?.sequenceNumber, 6)
+    XCTAssertEqual(h.audio.startCalls, 1)
+    XCTAssertEqual(h.audio.releaseCalls, 1)
+    XCTAssertTrue(h.sink.terminations.isEmpty)
+    result.finalPacket?.bytes.zeroize()
+  }
