{
  "manifest_version": 3,
  "name": "CosmaBot · local sign-in proof",
  "version": "0.1.0",
  "key": "",
  "permissions": ["sidePanel", "storage", "clipboardWrite"],
  "host_permissions": ["http://127.0.0.1:8765/*", "http://127.0.0.1:8766/*"],
  "background": {"service_worker": "worker.js", "type": "module"},
  "action": {"default_title": "Open CosmaBot local proof"},
  "side_panel": {"default_path": "panel.html"},
  "content_scripts": [{"matches": ["http://127.0.0.1:8765/schedule.html"], "js": ["content.js"], "run_at": "document_idle"}],
  "content_security_policy": {"extension_pages": "default-src 'self'; script-src 'self'; object-src 'none'; frame-src 'none'; form-action 'none'; connect-src http://127.0.0.1:8766; base-uri 'none'"}
}
