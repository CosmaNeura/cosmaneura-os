[Unit]
Description=CosmaBot bounded PostgreSQL backup job %i
After=cosmabot-backup-receive.service network-online.target
Requires=cosmabot-backup-receive.service

[Service]
Type=oneshot
User=cosmabot-backup
Group=cosmabot-backup
Environment=COSMABOT_BACKUP_ACTION=%i
LoadCredential=azure.pem:/etc/cosmabot/backup/secrets/writer.pem
LoadCredential=pgpass:/etc/cosmabot/backup/secrets/pgpass
ExecStart=/usr/bin/python3 -I /opt/cosmabot/backup/backup.py %i
TimeoutStartSec=7800
TimeoutStopSec=30
KillMode=control-group
StateDirectory=cosmabot-backup
StateDirectoryMode=0700
StandardOutput=journal
StandardError=journal
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectProc=invisible
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6
IPAddressDeny=127.0.0.0/8 ::1 169.254.0.0/16 fe80::/10
BindReadOnlyPaths=/etc/cosmabot/backup/resolv.conf:/etc/resolv.conf
InaccessiblePaths=/var/lib/cosmabot /etc/cosmabot/runtime /run/docker.sock /var/run/docker.sock -/var/lib/waagent
MemoryMax=768M
CPUQuota=25%
TasksMax=64
