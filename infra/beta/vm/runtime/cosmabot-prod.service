[Unit]
Description=CosmaBot synthetic production runtime
Requires=docker.service
PartOf=docker.service
After=docker.service network-online.target
Wants=network-online.target
RequiresMountsFor=/var/lib/cosmabot

[Service]
Type=oneshot
RemainAfterExit=yes
# Root-owned, public file containing only RELEASE_DIR=/opt/cosmabot/releases/<id>.
EnvironmentFile=/etc/cosmabot/active-release
# /run is tmpfs; create /run/cosmabot before ExecStart so ProtectSystem=strict
# + ReadWritePaths does not fail with 226/NAMESPACE after reboot.
# Preserve across stop/fail/restart so start.sh's runtime.lock is not deleted
# while prepare/migration may still hold it.
RuntimeDirectory=cosmabot
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
ExecStart=/bin/sh ${RELEASE_DIR}/start.sh ${RELEASE_DIR} run
ExecStop=/bin/sh ${RELEASE_DIR}/start.sh ${RELEASE_DIR} stop
TimeoutStartSec=240
TimeoutStopSec=180
# Hardening compatible with root start.sh + docker CLI (socket to dockerd).
# Container process UID drop is NOT here: compose sets non-root users for
# api/worker and data services in infra/beta/vm/runtime/render.py.
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ReadWritePaths=/var/lib/cosmabot /run/cosmabot
# Omitted (would break start.sh / docker client / IMDS guard):
# - User= / DynamicUser= : start.sh requires uid 0
# - PrivateDevices= : docker CLI may need host /dev visibility
# - PrivateNetwork= : needs docker networks and DNS
# - RestrictNamespaces= : docker client may enter namespaces via the API path
# - RestrictAddressFamilies=AF_INET AF_INET6 : needs AF_UNIX for docker.sock
# - CapabilityBoundingSet= (empty) : leave root caps for docker socket client
# - InaccessiblePaths= for /run/docker.sock : start.sh talks to dockerd
# - ProtectKernelModules=yes : imds-guard.sh runs iptables (-m comment, REJECT,
#   DOCKER-USER); xt_* / ip_tables modules may need to autoload on first use

[Install]
WantedBy=multi-user.target
