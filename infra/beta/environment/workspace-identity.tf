variable "workspace_operational_identity" {
  description = "Existing public desktop identity schema shared with all client builds. No credential or activation authority."
  type = object({
    version        = number
    profile        = string
    client         = string
    apiOrigin      = string
    publishableKey = string
    frontendOrigin = string
    organizationId = string
    audience       = string
  })
  default = null
}

variable "workspace_native_release" {
  description = "Human-controlled native release evidence for the exact identity and both signed/qualified client archives. Never generated by build-input preparation."
  type = object({
    identity_sha256        = string
    desktop_archive_sha256 = string
    iphone_archive_sha256  = string
    acceptance_reference   = string
  })
  sensitive = true
  default   = null
}

locals {
  workspace_identity_sha256 = var.workspace_operational_identity == null ? null : sha256(jsonencode(var.workspace_operational_identity))
  workspace_identity_valid = try(
    var.workspace_operational_identity.version == 1 &&
    var.workspace_operational_identity.profile == "operational-beta-v1" &&
    var.workspace_operational_identity.client == "desktop" &&
    var.workspace_operational_identity.apiOrigin == local.api_origin &&
    length(var.workspace_operational_identity.frontendOrigin) <= 253 &&
    can(regex("^https://[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)*\\.[a-z]([a-z0-9-]*[a-z0-9])?$", var.workspace_operational_identity.frontendOrigin)) &&
    !endswith(var.workspace_operational_identity.frontendOrigin, ".localhost") &&
    !endswith(var.workspace_operational_identity.frontendOrigin, ".clerk.accounts.dev") &&
    var.workspace_operational_identity.frontendOrigin == trimsuffix(var.clerk_issuer_url, "/") &&
    var.clerk_jwks_url == "${var.workspace_operational_identity.frontendOrigin}/.well-known/jwks.json" &&
    var.workspace_operational_identity.organizationId == var.clerk_org_id &&
    can(regex("^org_[A-Za-z0-9_]{1,251}$", var.workspace_operational_identity.organizationId)) &&
    var.workspace_operational_identity.audience == var.clerk_audience &&
    can(regex("^[!-~]{1,255}$", var.workspace_operational_identity.audience)) &&
    length(var.workspace_operational_identity.publishableKey) <= 1024 &&
    can(regex("^pk_live_[A-Za-z0-9+/_-]+={0,2}$", var.workspace_operational_identity.publishableKey)) &&
    trim(replace(replace(trimprefix(var.workspace_operational_identity.publishableKey, "pk_live_"), "-", "+"), "_", "/"), "=") ==
    trim(base64encode("${trimprefix(var.workspace_operational_identity.frontendOrigin, "https://")}$"), "="),
  false)
  workspace_native_release_valid = try(
    var.workspace_native_release.identity_sha256 == local.workspace_identity_sha256 &&
    can(regex("^[0-9a-f]{64}$", var.workspace_native_release.desktop_archive_sha256)) &&
    can(regex("^[0-9a-f]{64}$", var.workspace_native_release.iphone_archive_sha256)) &&
    var.workspace_native_release.desktop_archive_sha256 != var.workspace_native_release.iphone_archive_sha256 &&
    length(trimspace(var.workspace_native_release.acceptance_reference)) >= 3 &&
    length(var.workspace_native_release.acceptance_reference) <= 2048,
  false)
}

output "workspace_operational_identity_sha256" {
  description = "Public identity binding for separately controlled native release evidence; null for the legacy profile."
  value       = local.workspace_identity_sha256
}
