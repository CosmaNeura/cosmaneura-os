# Node 24.19 matches the hosted client runtime and is pinned by registry digest.
ARG NODE_BUILD_IMAGE=node:24.19.0-alpine@sha256:d32cdf619f63fe0471182d08996dd516c6275bb5fd31ae06e55a570bd9e1ad43
FROM ${NODE_BUILD_IMAGE} AS build
WORKDIR /build/web
COPY web/package.json web/pnpm-lock.yaml ./
RUN corepack enable && pnpm config set store-dir /pnpm/store && pnpm fetch --frozen-lockfile --ignore-scripts
RUN --network=none pnpm install --frozen-lockfile --offline --ignore-scripts
WORKDIR /build/clients/capture
COPY clients/capture/package.json clients/capture/pnpm-lock.yaml ./
RUN pnpm fetch --frozen-lockfile --ignore-scripts
RUN --network=none pnpm install --frozen-lockfile --offline --ignore-scripts
WORKDIR /build/web
COPY web/ ./
COPY clients/capture/ /build/clients/capture/
COPY clients/shared/ /build/clients/shared/
COPY clients/scribe-review/ /build/clients/scribe-review/
COPY clients/desktop/google-navigation.mjs /build/clients/desktop/google-navigation.mjs
COPY clients/desktop/google-navigation.d.mts /build/clients/desktop/google-navigation.d.mts
COPY clients/desktop/scribe-source-requests.mjs /build/clients/desktop/scribe-source-requests.mjs
COPY clients/desktop/scribe-source-requests.d.mts /build/clients/desktop/scribe-source-requests.d.mts
COPY tests/fixtures/ /build/tests/fixtures/
ARG VITE_CLERK_PUBLISHABLE_KEY
ARG VITE_WORKSPACE_HOSTED_API_ORIGIN
ARG VITE_WORKSPACE_WEB_ORIGIN
ARG VITE_WORKSPACE_DATA_MODE=synthetic
ARG VITE_COSMANEURA_WEB_ORIGIN
ARG VITE_CAPTURE_UPLOAD_ORIGINS
ARG VITE_WORKSPACE_CAPTURE_MODE=browser_microphone
ARG VITE_MESSAGES_ENABLED=false
ENV VITE_MESSAGES_ENABLED=${VITE_MESSAGES_ENABLED}
ENV VITE_WORKSPACE_FEATURE_PROFILE=operational-beta-v1 \
    VITE_WORKSPACE_HOSTED_CLIENT=web \
    VITE_WORKSPACE_DATA_MODE=${VITE_WORKSPACE_DATA_MODE} \
    VITE_WORKSPACE_CAPTURE_MODE=${VITE_WORKSPACE_CAPTURE_MODE} \
    VITE_CAPTURE_UPLOAD_ORIGINS=${VITE_CAPTURE_UPLOAD_ORIGINS} \
    VITE_COSMANEURA_WEB_ORIGIN=${VITE_COSMANEURA_WEB_ORIGIN} \
    VITE_CLERK_PUBLISHABLE_KEY=${VITE_CLERK_PUBLISHABLE_KEY} \
    VITE_API_BASE=${VITE_WORKSPACE_HOSTED_API_ORIGIN} \
    VITE_WORKSPACE_HOSTED_API_ORIGIN=${VITE_WORKSPACE_HOSTED_API_ORIGIN} \
    VITE_WORKSPACE_WEB_ORIGIN=${VITE_WORKSPACE_WEB_ORIGIN}
RUN --network=none pnpm run build:beta
# Nginx 1.30.6 includes the fixes required by the release vulnerability scan.
FROM nginxinc/nginx-unprivileged:stable-alpine@sha256:f5116ed4606f3eb015dd4a8e28cb9b351476dc0ad4bc6e9f93b19cec130cdf03
USER root
# Apply the verified Alpine security fixes omitted by this pinned base.
RUN apk add --no-cache --upgrade pcre2=10.49-r0 tiff=4.7.2-r0 \
    libexpat=2.9.0-r0 libx11=1.8.14-r0 brotli-libs=1.2.1-r0
USER 101:101
COPY --from=build /build/web/.beta/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /build/web/dist /usr/share/nginx/html
COPY docs/third-party/activepieces-LICENSE.txt /usr/share/nginx/html/licenses/activepieces-LICENSE.txt
USER 101:101
EXPOSE 8080
