# Placeholders only — never put real credentials or PHI here.
DATABASE_URL=postgresql+psycopg://cosmas:cosmas@localhost:54329/cosmas_os
REDIS_URL=redis://localhost:63799/0
COSMAS_ENV=synth_os
DATA_MODE=synthetic
AUTH_MODE=synth_headers
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SYNTH_SEED=true
BLOB_BACKEND=local
BLOB_ROOT=./data/blobs
SYNC_WORKER=true
# Read-only private AI activity; does not enable model execution or recovery actions.
WORKSPACE_AI_ACTIVITY_ENABLED=false
# VITE_AI_ACTIVITY_ENABLED=false
# Local connector configuration and outbound execution are independently disabled.
VENDOR_SETUP_ENABLED=false
MANAGED_SERVICES_CONFIG_PATH=
MANAGED_SERVICES_CONFIG_JSON=
MANAGED_SERVICES_CONFIG_SHA256=
# VITE_VENDOR_SETUP_ENABLED=false
PORTAL_SETUP_ENABLED=false
# VITE_PORTAL_SETUP_ENABLED=false
PORTAL_WORK_ENABLED=false
PORTAL_IO_ENABLED=false
# VITE_PORTAL_WORK_ENABLED=false
FINANCE_WORK_ENABLED=false
FINANCE_SETUP_ENABLED=false
# VITE_FINANCE_SETUP_ENABLED=false
FINANCE_IO_ENABLED=false
FINANCE_EVENTS_ENABLED=false
# VITE_FINANCE_WORK_ENABLED=false
INBOX_WORK_ENABLED=false
INBOX_HANDOFF_ENABLED=false
MEMBERSHIP_WORK_ENABLED=false
# VITE_INBOX_WORK_ENABLED=false
INBOX_HANDOFF_ENABLED=false
MEMBERSHIP_WORK_ENABLED=false
# Optional: override clock for demos (ISO-8601). Leave empty for system time.
# COSMAS_CLOCK_NOW=

# D3 web build-time configuration. Keep these unset for the local synth UI.
# Supply only a Clerk publishable key here; never expose a Clerk secret key as VITE_*.
# VITE_COSMAS_ENV=early_adopter_beta
# VITE_API_BASE=https://<approved-beta-api-host>
# VITE_CLERK_PUBLISHABLE_KEY=<human-supplied-production-pk_live-publishable-key>

# Personal Microsoft email/calendar (read-only delegated access; default off).
WORKSPACE_MICROSOFT_CONNECTION_ENABLED=false
MICROSOFT_CONNECTION_TENANT_ID=
MICROSOFT_CONNECTION_CLIENT_ID=
MICROSOFT_CONNECTION_CLIENT_SECRET=
MICROSOFT_CONNECTION_CALLBACK_URI=
MICROSOFT_CONNECTION_RETURN_ORIGIN=
MICROSOFT_CONNECTION_ENCRYPTION_KEY=

# Optional reviewed Athena-to-Core visit links; requires authenticated Core/Athena.
WORKSPACE_ATHENA_VISIT_LINK_ENABLED=false

# Optional first connection for members of one owner-reviewed Scheduling practice.
WORKSPACE_SCHEDULING_ENROLLMENT_ENABLED=false
SCHEDULING_ENROLLMENT_PRACTICE_ID=
