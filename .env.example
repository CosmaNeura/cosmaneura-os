# Placeholders only — never put real credentials or PHI here.
DATABASE_URL=postgresql+psycopg://cosmas:cosmas@localhost:54329/cosmas_os
REDIS_URL=redis://localhost:63799/0
COSMAS_ENV=synth_os
DATA_MODE=synthetic
AUTH_MODE=synth_headers
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SYNTH_SEED=true
BLOB_BACKEND=local
BLOB_ROOT=./data/blobs
SYNC_WORKER=true
# Optional: override clock for demos (ISO-8601). Leave empty for system time.
# COSMAS_CLOCK_NOW=

# D3 web build-time configuration. Keep these unset for the local synth UI.
# Supply only a Clerk publishable key here; never expose a Clerk secret key as VITE_*.
# VITE_COSMAS_ENV=early_adopter_beta
# VITE_API_BASE=https://<approved-beta-api-host>
# VITE_CLERK_PUBLISHABLE_KEY=<human-supplied-production-pk_live-publishable-key>
